# Darrock Frontend Environment
# Copy this to .env and adjust as needed. All values below are the defaults.

# "development" (default) → proxy URL + Basic Auth
# "production"            → localhost, no auth
DARROCK_ENV=development

# Override backend URL (optional — normally set by DARROCK_ENV)
# DARROCK_BACKEND_URL=https://darrock-backend.viasyazilim.com/api/v2

# Flask session encryption key (change in production)
# FLASK_SECRET_KEY=darrock-research-frontend-dev-key

# Backend request timeout in seconds
# DARROCK_BACKEND_TIMEOUT=300
